    ["Can boutiques source Engagement Rings?","Yes, boutiques can explore Engagement Rings for Women, diamond engagement rings, gold engagement rings, and custom designs for their jewelry collections."],
    ["Can I create a complete Engagement Ring Collection?","Yes, businesses can develop an Engagement Ring Collection with different styles such as solitaire, halo, oval, pear-shaped, gold, diamond, sapphire, and custom engagement rings."],
    ["What should I look for when buying an Engagement Ring Online?","When buying an Engagement Ring Online, check the product specifications, gemstone details, metal type, ring size, certification where applicable, return policy, and seller information."],
    ["What makes a Diamond Engagement Ring special?","A Diamond Engagement Ring combines the symbolism of an engagement ring with the durability and brilliance of a diamond. Design, diamond quality, setting, and craftsmanship all contribute to the final appearance."],
    ["Where can I explore different Engagement Ring designs?","You can explore an Engagement Collection featuring Engagement Rings for Women, Diamond Engagement Rings, Gold Engagement Rings, Solitaire Engagement Rings, Halo Engagement Rings, Oval Engagement Rings, Custom Engagement Rings, and other styles."]
  ];

  const listEl = document.getElementById('faqList');
  const countEl = document.getElementById('faqCount');
  const emptyEl = document.getElementById('faqEmpty');

  function renderFAQs(items){
    listEl.innerHTML = '';
    items.forEach(([q,a], idx) => {
      const item = document.createElement('div');
      item.className = 'faq-item';
      item.innerHTML = `
        <div class="faq-q" onclick="toggleFAQ(this)">
          <span class="num">${String(idx+1).padStart(2,'0')}</span>
          <h3>${q}</h3>
          <span class="faq-toggle"></span>
        </div>
        <div class="faq-a"><div class="faq-a-inner">${a}</div></div>
      `;
      listEl.appendChild(item);
    });
  }

  function toggleFAQ(header){
    const item = header.parentElement;
    const answer = item.querySelector('.faq-a');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => {
      el.classList.remove('open');
      el.querySelector('.faq-a').style.maxHeight = null;
    });
    if(!isOpen){
      item.classList.add('open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  }

  function filterFAQs(){
    const term = document.getElementById('faqSearchInput').value.toLowerCase().trim();
    const filtered = term
      ? faqs.filter(([q,a]) => q.toLowerCase().includes(term) || a.toLowerCase().includes(term))
      : faqs;
    renderFAQs(filtered);
    countEl.textContent = term ? `filtered.lengthresult{filtered.length!==1?'s':''} found` : `${faqs.length} questions answered`;
    emptyEl.style.display = filtered.length === 0 ? 'block' : 'none';
  }

  renderFAQs(faqs);
  countEl.textContent = `${faqs.length} questions answered`;
</script>
</body>

