    margin:0 auto 18px;
  }
  .hero p.lede{
    max-width:560px;
    margin:0 auto;
    font-size:17px;
    color:var(--ink-soft);
    font-weight:300;
  }

  .faq-section{ padding:56px 0 80px; }

  .faq-search{
    max-width:460px;
    margin:0 auto 40px;
    position:relative;
  }
  .faq-search input{
    width:100%;
    padding:14px 44px 14px 18px;
    border:1px solid var(--line);
    border-radius:30px;
    background:var(--surface);
    font-family:'Jost',sans-serif;
    font-size:14.5px;
    color:var(--ink);
    outline:none;
    transition:border-color .2s ease;
  }
  .faq-search input:focus{ border-color:var(--gold); }
  .faq-search svg{
    position:absolute; right:16px; top:50%; transform:translateY(-50%);
    width:16px; height:16px; color:var(--ink-soft); pointer-events:none;
  }

  .faq-count{
    text-align:center;
    font-size:13px;
    color:var(--ink-soft);
    letter-spacing:.05em;
    margin:-24px 0 30px;
  }

  .faq-list{ display:flex; flex-direction:column; gap:10px; }

  .faq-item{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:8px;
    overflow:hidden;
    transition:border-color .2s ease;
  }
  .faq-item.open{ border-color:var(--gold-light); }

  .faq-q{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:18px 22px;
    cursor:pointer;
    user-select:none;
  }
  .faq-q .num{
    font-family:'Cormorant Garamond', serif;
    font-size:15px;
    color:var(--gold);
    flex:0 0 auto;
    min-width:22px;
  }
  .faq-q h3{
    font-family:'Jost', sans-serif;
    font-weight:500;
    font-size:16px;
    color:var(--ink);
    flex:1;
  }
  .faq-toggle{
    flex:0 0 auto;
    width:26px; height:26px;
    border-radius:50%;
    border:1px solid var(--gold);
    display:flex; align-items:center; justify-content:center;
    position:relative;
  }
  .faq-toggle::before, .faq-toggle::after{
    content:'';
    position:absolute;
    background:var(--gold);
    transition:transform .25s ease, opacity .25s ease;
  }
  .faq-toggle::before{ width:11px; height:1.4px; }
  .faq-toggle::after{ width:1.4px; height:11px; }
  .faq-item.open .faq-toggle::after{ transform:rotate(90deg); opacity:0; }

  .faq-a{
    max-height:0;
    overflow:hidden;
    transition:max-height .3s ease;
  }
  .faq-a-inner{
    padding:0 22px 20px 60px;
    font-size:15px;
    color:var(--ink-soft);
    max-width:640px;
  }
  @media (max-width:600px){
    .faq-a-inner{ padding-left:22px; }
  }

  .faq-empty{
    text-align:center;
    color:var(--ink-soft);
    font-size:15px;
    padding:40px 0;
    display:none;
  }

  .faq-cta{
    margin-top:56px;
    text-align:center;
    padding:40px 32px;
    background:var(--cream-2);
    border-radius:10px;
  }
  .faq-cta h2{ font-size:28px; margin-bottom:12px; }
  .faq-cta p{ color:var(--ink-soft); font-size:15px; margin-bottom:22px; max-width:480px; margin-left:auto; margin-right:auto; }
  .btn-gold{
    display:inline-block;
    background:var(--gold-light);
    color:var(--navy);
    padding:14px 32px;
    font-size:13.5px;
    letter-spacing:.12em;
    text-decoration:none;
    border-radius:2px;
    font-family:'Jost',sans-serif;
    font-weight:500;
    transition:opacity .2s ease;
  }
  .btn-gold:hover{ opacity:.85; }
</style>

  <section class="faq-section" style="padding-top:48px;">
    <div class="wrap">
