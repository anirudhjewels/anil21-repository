    ["What is a Pendant Manufacturer?","A Pendant Manufacturer produces pendants according to specific designs, materials, gemstones, sizes, and production requirements. Manufacturers can work on both standard and custom designs."],
    ["What is a Pendant Manufacturer USA?","A Pendant Manufacturer USA generally refers to a manufacturer operating in or serving the US market. Businesses should verify the manufacturer's location, capabilities, and services before placing an order."],
    ["Can USA businesses source Pendants from a manufacturer?","Yes, USA businesses can source Pendants from manufacturers for wholesale, custom, private-label, and other jewelry business requirements."],
    ["What are Gold Pendants in USA?","Gold Pendants in USA refers to gold pendant jewelry available for buyers or businesses in the US market. Designs can include simple, diamond, gemstone, personalized, and custom options."],
    ["What are Diamond Pendants in USA?","Diamond Pendants in USA are diamond pendant jewelry options available for the US market. Buyers can compare diamond details, gold type, pendant design, and product specifications."],
    ["What are Gemstone Pendants USA?","Gemstone Pendants USA refers to gemstone pendant jewelry offered for the US market. Options can include ruby, sapphire, emerald, amethyst, birthstone, and other gemstone designs."],
    ["What are Custom Pendants USA?","Custom Pendants USA refers to personalized pendant designs created according to specific requirements for the US market. Customization can include the metal, gemstone, shape, size, engraving, or design."],
    ["What is B2B Pendant Jewelry?","B2B Pendant Jewelry refers to pendant jewelry supplied or manufactured for businesses such as retailers, jewelry brands, boutiques, wholesalers, and online stores."],
    ["Does Anirudh Jewels offer Pendants for wholesale and custom requirements?","Anirudh Jewels works with jewelry manufacturing and can discuss Gold Pendants, Diamond Pendants, Gemstone Pendants, Custom Pendants, and Wholesale Pendants for business requirements. Buyers can discuss their preferred designs, materials, gemstones, and quantities."]
  ];

  const listEl = document.getElementById('faqList');
  const countEl = document.getElementById('faqCount');
  const emptyEl = document.getElementById('faqEmpty');

  function renderFAQs(items){
    listEl.innerHTML = '';
    items.forEach(([q,a], idx) => {
      const item = document.createElement('div');
      item.className = 'faq-item';
      item.innerHTML = `
        <div class="faq-q" onclick="toggleFAQ(this)">
          <span class="num">${String(idx+1).padStart(2,'0')}</span>
          <h3>${q}</h3>
          <span class="faq-toggle"></span>
        </div>
        <div class="faq-a"><div class="faq-a-inner">${a}</div></div>
      `;
      listEl.appendChild(item);
    });
  }

  function toggleFAQ(header){
    const item = header.parentElement;
    const answer = item.querySelector('.faq-a');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => {
      el.classList.remove('open');
      el.querySelector('.faq-a').style.maxHeight = null;
    });
    if(!isOpen){
      item.classList.add('open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  }

  function filterFAQs(){
    const term = document.getElementById('faqSearchInput').value.toLowerCase().trim();
    const filtered = term
      ? faqs.filter(([q,a]) => q.toLowerCase().includes(term) || a.toLowerCase().includes(term))
      : faqs;
    renderFAQs(filtered);
    countEl.textContent = term ? `${filtered.length} result${filtered.length!==1?'s':''} found` : `${faqs.length} questions answered`;
    emptyEl.style.display = filtered.length === 0 ? 'block' : 'none';
  }

  renderFAQs(faqs);
  countEl.textContent = `${faqs.length} questions answered`;
</script>
</body>
