    ["Can I buy Wholesale Gemstone Rings?","Yes, jewelry businesses can source Wholesale Gemstone Rings for retail stores, boutiques, brands, and online jewelry businesses. Wholesale orders can be discussed according to designs and required quantities."],
    ["What are Wholesale Colour Stone Rings?","Wholesale Colour Stone Rings are supplied to jewelry businesses in quantities intended for resale or commercial collections. They can include different gemstones, metals, designs, and customized requirements."],
    ["What is a Gemstone Ring Manufacturer?","A Gemstone Ring Manufacturer produces rings featuring gemstones according to specific designs and production requirements. Manufacturers may work with different gemstones, metals, sizes, and quantities."],
    ["What is a Gemstone Ring Manufacturer USA?","A Gemstone Ring Manufacturer USA generally refers to a manufacturer operating in or serving the US market. Buyers should verify the manufacturer's location, production capabilities, and business services."],
    ["Can USA businesses source Gemstone Rings from a manufacturer?","Yes, USA businesses can source Gemstone Rings from manufacturers for wholesale, custom, private-label, and other business requirements. Buyers can discuss designs, gemstones, quantities, and production specifications."],
    ["What is Wholesale Gemstone Jewelry?","Wholesale Gemstone Jewelry refers to gemstone jewelry supplied to businesses in quantities intended for resale or commercial use. It can include rings and other jewelry pieces featuring different gemstones."],
    ["What is B2B Gemstone Jewelry?","B2B Gemstone Jewelry refers to gemstone jewelry supplied or manufactured for businesses such as retailers, jewelry brands, boutiques, wholesalers, and online stores."],
    ["Does Anirudh Jewels offer Colour Stone Rings for wholesale and custom requirements?","Anirudh Jewels works with gemstone jewelry manufacturing and can discuss Colour Stone Rings, Custom Gemstone Rings, Gold Gemstone Rings, and Wholesale Gemstone Rings. Business buyers can discuss their preferred designs, gemstones, metals, and quantities."]
  ];

  const listEl = document.getElementById('faqList');
  const countEl = document.getElementById('faqCount');
  const emptyEl = document.getElementById('faqEmpty');

  function renderFAQs(items){
    listEl.innerHTML = '';
    items.forEach(([q,a], idx) => {
      const item = document.createElement('div');
      item.className = 'faq-item';
      item.innerHTML = `
        <div class="faq-q" onclick="toggleFAQ(this)">
          <span class="num">${String(idx+1).padStart(2,'0')}</span>
          <h3>${q}</h3>
          <span class="faq-toggle"></span>
        </div>
        <div class="faq-a"><div class="faq-a-inner">${a}</div></div>
      `;
      listEl.appendChild(item);
    });
  }

  function toggleFAQ(header){
    const item = header.parentElement;
    const answer = item.querySelector('.faq-a');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => {
      el.classList.remove('open');
      el.querySelector('.faq-a').style.maxHeight = null;
    });
    if(!isOpen){
      item.classList.add('open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  }

  function filterFAQs(){
    const term = document.getElementById('faqSearchInput').value.toLowerCase().trim();
    const filtered = term
      ? faqs.filter(([q,a]) => q.toLowerCase().includes(term) || a.toLowerCase().includes(term))
      : faqs;
    renderFAQs(filtered);
    countEl.textContent = term ? `${filtered.length} result${filtered.length!==1?'s':''} found` : `${faqs.length} questions answered`;
    emptyEl.style.display = filtered.length === 0 ? 'block' : 'none';
  }

  renderFAQs(faqs);
  countEl.textContent = `${faqs.length} questions answered`;
</script>
</body>
